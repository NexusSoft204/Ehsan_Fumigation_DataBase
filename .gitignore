# ==========================================
# 1. Frontend (React) - نادیده گرفتن فایل‌های فرانت‌اند
# ==========================================
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# ==========================================
# 2. Backend (Django) - نادیده گرفتن فایل‌های بک‌اند
# ==========================================
# دیتابیس محلی جنگو (بسیار مهم)
backend/db.sqlite3
backend/*.sqlite3

# فایل‌های کش پایتون
backend/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/**/*.pyd

# محیط‌های مجازی پایتون (اگر داخل پوشه بک‌اند ساخته شده‌اند)
backend/.venv/
backend/venv/
backend/env/

# فایل تنظیمات حساس (مثل توکن‌ها و پسوردها)
backend/.env

# رسانه‌ها و فایل‌های آپلود شده توسط کاربران در محیط تست
backend/media/

# ==========================================
# 3. General & IDEs - ابزارهای ادیتور و عمومی
# ==========================================
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
logs/
*.log
